DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/apigateway
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-this-to-a-random-32-char-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Upstream service (internal Docker network)
PROXY_API_URL=http://proxy_api:8521

# First admin user (created by seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_FULL_NAME=Admin
